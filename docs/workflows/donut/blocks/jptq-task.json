{
  "name": "jptq-task",
  "description": "Zařadí do fronty zpracování jedné karty. Exit 0 zařazeno, 1 už tam je; cokoliv jiného je skutečné selhání.",
  "command": "jptq",
  "args": [
    [
      "task"
    ],
    [
      "{%queueFile%}"
    ],
    [
      "{%taskId%}"
    ],
    [
      "donut"
    ],
    [
      "{%workflow%}"
    ],
    [
      "--SHORT_ID={%shortId%}"
    ],
    [
      "--EXPECT_STATUS={%expectStatus%}"
    ],
    [
      "--MODEL={%model%}"
    ],
    [
      "--SYSTEM_PROMPT={%systemPrompt%}"
    ],
    [
      "--TARGET_LIST={%targetList%}"
    ],
    [
      "--TAG={%tag%}"
    ],
    [
      "--CURLRC={%curlrc%}"
    ],
    [
      "--WORK_ROOT={%workRoot%}"
    ]
  ],
  "inputs": {
    "queueFile": {
      "required": true
    },
    "taskId": {
      "required": true,
      "description": "Identita úlohy ve frontě, kvůli deduplikaci"
    },
    "workflow": {
      "required": true,
      "description": "card-dev | card-spec"
    },
    "shortId": {
      "required": true
    },
    "expectStatus": {
      "required": true
    },
    "model": {
      "required": true
    },
    "systemPrompt": {
      "required": true
    },
    "targetList": {
      "required": true
    },
    "tag": {
      "required": true
    },
    "curlrc": {
      "required": false
    },
    "workRoot": {
      "required": true
    }
  },
  "allow_failure": [
    0,
    1
  ]
}
